#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.debug.xcconfig"
#include "Generated.xcconfig"

// Sign in with Apple. Here rather than in the target's build settings because
// the pbxproj is generated by `flutter create` and an edit to it is lost the
// next time anybody regenerates the iOS shell; an xcconfig include is not.
CODE_SIGN_ENTITLEMENTS = Runner/Runner.entitlements
